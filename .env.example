# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Admin login (seeded on first db:seed)
ADMIN_EMAIL=admin@signalpipe.local
ADMIN_PASSWORD=change-me-strong-password

# Database
DATABASE_URL=postgresql://signalpipe:signalpipe@localhost:5432/signalpipe?schema=public

# Webhook (also stored/overridable in Settings UI)
WEBHOOK_SECRET=change-me-webhook-secret

# Defaults (overridable in Settings UI)
# Tradovate login credentials are entered on the Accounts page — not here.
TRADOVATE_ENV=demo
TRADING_MODE=dry-run
DEFAULT_SYMBOL=MNQH5
DEFAULT_QTY=1
