# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Admin login (seeded on first db:seed)
ADMIN_EMAIL=admin@signalpipe.local
ADMIN_PASSWORD=change-me-strong-password

# Database
DATABASE_URL=postgresql://signalpipe:signalpipe@localhost:5432/signalpipe?schema=public

# Webhook (also stored/overridable in Settings UI)
WEBHOOK_SECRET=change-me-webhook-secret

# Tradovate API
# Demo: https://demo.tradovateapi.com
# Live: https://live.tradovateapi.com
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=SignalPipe
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=

# Safety defaults (overridable in Settings UI)
TRADING_MODE=dry-run
DEFAULT_SYMBOL=MNQH5
DEFAULT_QTY=1
